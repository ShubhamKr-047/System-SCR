{
  "name": "zen-chess-review",
  "version": "0.1.0",
  "private": true,
  "description": "Local Stockfish game review extension for Zen Browser",
  "type": "module",
  "scripts": {
    "test": "node --test tests/game-tree.test.js tests/engine.test.js tests/board.test.js tests/coaching.test.js",
    "test:browser": "npm run build && playwright test",
    "test:coaching": "npm run build && playwright test -c playwright.coaching.config.js",
    "copy-engine": "node scripts/copy-engine.mjs",
    "build": "npm run copy-engine && vite build",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "6.4.1"
  }
}
