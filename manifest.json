{
  "manifest_version": 3,
  "name": "System SCR",
  "version": "0.2.0",
  "description": "Local Stockfish game analysis and review for Zen Browser.",
  "icons": {
    "16": "icons/rook-16.png",
    "32": "icons/rook-32.png",
    "48": "icons/rook-48.png",
    "96": "icons/rook-96.png",
    "128": "icons/rook-128.png"
  },
  "action": {
    "default_title": "System SCR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/rook-16.png",
      "32": "icons/rook-32.png",
      "48": "icons/rook-48.png",
      "96": "icons/rook-96.png",
      "128": "icons/rook-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://api.chess.com/*",
    "https://lichess.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "launcher.css"
      ]
    },
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "lichess-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "launcher.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-chess-review@example.local",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
